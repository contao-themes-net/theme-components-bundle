{% extends "@Contao/content_element/hyperlink.html.twig" %}

{% use "@Contao/component/_stylesheet.html.twig" %}

{% block wrapper %}
    {% set attributes = attrs(attributes|default).addClass(['icon-tile']) %}
    {{ parent() }}
{% endblock %}

{% block content %}
    {# Adds a stylesheet #}
    {% add "icon_tile_scss" to stylesheets %}
        {% with {file: asset('bundles/themecomponents/scss/icon_tile.scss')} %}
            {{ block('stylesheet_component') }}
        {% endwith %}
    {% endadd %}

    {% block image_link %}
        <a{{ link_attributes }}>
            {% with {figure: image} %}
                {{ block('figure_component') }}
            {% endwith %}
            {% block text_link %}
                {% if data.linkTitle %}
                    <div class="icon-tile__label">
                        {{- text_before -}}
                        {{ link_text|insert_tag }}
                        {{- text_after -}}
                    </div>
                {% endif %}
            {% endblock %}
        </a>
    {% endblock %}
{% endblock %}

{% block media_link %}
    {% set link_attributes = attrs(figure.linkAttributes(true)|default)
        .setIfExists('title', figure.hasLightbox and figure.hasMetadata ? figure.metadata.title : null)
        .mergeWith(figure.options.link_attr|default)
        .mergeWith(link_attributes|default)
    %}
    {{ block('media') }}
{% endblock %}
